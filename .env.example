APP_NAME=Zed-Fin_LMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --------------------------------------------------------------------------
# Vercel production overrides — set these in the Vercel dashboard's
# Environment Variables, NOT in this file. Left here as documentation only.
# --------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://<your-project>.vercel.app
# VERCEL=1                         # already set automatically by Vercel
#
# LOG_CHANNEL=stderr               # Vercel's filesystem is read-only
#
# CACHE_DRIVER=database            # run `php artisan migrate` once to create the cache table
#
# VIEW_COMPILED_PATH=/tmp/views    # writable path for compiled Blade views
#
# QUEUE_CONNECTION=sync            # unchanged — no queue worker runs on Vercel
#
# # TiDB Cloud Serverless (MySQL-compatible)
# DB_CONNECTION=mysql
# DB_HOST=<gateway-region>.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=lms
# DB_USERNAME=<tidb-username>
# DB_PASSWORD=<tidb-password>
# MYSQL_ATTR_SSL_CA=/etc/ssl/cert.pem   # TiDB requires TLS; this is Amazon Linux's default CA bundle, already present in the Vercel PHP runtime
#
# # Cloudflare R2 (S3-compatible) — for borrower docs, loan PDFs, repayment proofs
# FILESYSTEM_DRIVER=s3             # switches config/filesystems.php's named disks from local to S3
# AWS_ACCESS_KEY_ID=<r2-access-key-id>
# AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=<r2-bucket-name>
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_URL=https://<your-public-r2-domain-or-bucket-url>
# AWS_USE_PATH_STYLE_ENDPOINT=true
#
# CRON_SECRET=<random-string>      # Vercel Cron sends this as "Authorization: Bearer <value>"
